{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "只言",
  "version": "0.7.0",
  "identifier": "com.duketao.zhiyan.cross",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../web-dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "只言",
        "width": 1120,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"],
    "iOS": { "minimumSystemVersion": "16.0" },
    "android": { "minSdkVersion": 26 }
  }
}
