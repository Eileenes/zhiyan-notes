POSTGRES_PASSWORD=replace-with-a-long-random-url-safe-value
REGISTRATION_MODE=invite
REGISTRATION_INVITE=replace-with-your-beta-invite-code
# Optional: used only by compose.public.yaml; do not include https://.
SYNC_DOMAIN=sync.example.com
# Optional: comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For
# is trusted for rate limiting. compose.public.yaml sets this for its Caddy.
# Leave empty when clients connect directly.
TRUSTED_PROXIES=
