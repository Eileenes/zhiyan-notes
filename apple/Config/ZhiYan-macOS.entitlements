<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Sandbox (Mac App Store requirement; also fine for Developer ID). -->
	<key>com.apple.security.app-sandbox</key><true/>
	<!-- Sync service and user-configured model providers (HTTPS). -->
	<key>com.apple.security.network.client</key><true/>
	<!-- Optional external API: MCP / OpenAI-compatible server on 127.0.0.1 only. -->
	<key>com.apple.security.network.server</key><true/>
	<!-- Voice notes (AVAudioRecorder). Also needs NSMicrophoneUsageDescription. -->
	<key>com.apple.security.device.audio-input</key><true/>
	<!-- Read-only access to folders the user picks in NSOpenPanel: needed for
	     the legacy-data import fallback (docs/SANDBOX-MIGRATION.md 2.2). Exports
	     are written inside the container and revealed in Finder; no write or
	     Downloads access is requested. -->
	<key>com.apple.security.files.user-selected.read-only</key><true/>
	<key>keychain-access-groups</key>
	<array><string>$(AppIdentifierPrefix)$(PRODUCT_BUNDLE_IDENTIFIER)</string></array>
</dict>
</plist>
